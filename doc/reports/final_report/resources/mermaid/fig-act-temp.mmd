flowchart LR
    subgraph s1["find_candidate_stations(...)"]
        direction TB
        debut((" ")) --> in["lieux, période, n"]
        in --> a1("Trier les stations<br/>par distance (Haversine)")
        a1 --> m0{" "}
        m0 --> a2("Retenir les n premières<br/>stations non écartées")
